@model EuforiaEssencePW.Models.ViewModels.CambiarClaveViewModel

@{
    ViewData["Title"] = "Cambiar contraseña";
}

<section class="ee-cuenta">
    <header class="ee-cuenta-encabezado">
        <div>
            <span class="ee-cuenta-etiqueta">Mi cuenta</span>
            <h1>Cambiar contraseña</h1>
        </div>
    </header>

    <div class="row">
        <div class="col-lg-7">
            <div class="ee-checkout-panel">
                <form asp-action="CambiarClave" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Actual"
                               class="form-label"></label>

                        <input asp-for="Actual"
                               autocomplete="current-password"
                               class="form-control" />

                        <span asp-validation-for="Actual"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Nueva"
                               class="form-label"></label>

                        <input asp-for="Nueva"
                               autocomplete="new-password"
                               class="form-control" />

                        <span asp-validation-for="Nueva"
                              class="text-danger"></span>

                        <div class="form-text">
                            Entre 8 y 100 caracteres, con mayúscula,
                            minúscula, número y símbolo.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Confirmacion"
                               class="form-label"></label>

                        <input asp-for="Confirmacion"
                               autocomplete="new-password"
                               class="form-control" />

                        <span asp-validation-for="Confirmacion"
                              class="text-danger"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">
                            Actualizar contraseña
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Volver a mi perfil
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
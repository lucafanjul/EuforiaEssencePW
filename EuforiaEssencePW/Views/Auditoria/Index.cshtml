@model EuforiaEssencePW.Models.ViewModels.AuditoriaViewModel
@using EuforiaEssencePW.Services

@{
    ViewData["Title"] = "Centro de auditoría";
}

<section class="ee-auditoria">
    <header class="ee-cuenta-encabezado">
        <div>
            <span class="ee-cuenta-etiqueta">Administración · Control</span>
            <h1>Centro de auditoría</h1>
            <p>Operaciones del negocio y errores registrados.</p>
        </div>
    </header>

    <nav class="ee-auditoria-secciones"
         aria-label="Secciones de auditoría">
        @foreach (var seccion in AuditoriaConsultas.Secciones)
        {
            <a asp-controller="Auditoria"
               asp-action="Index"
               asp-route-seccion="@seccion.Key"
               asp-route-desde="@(Model.Desde?.ToString("yyyy-MM-dd"))"
               asp-route-hasta="@(Model.Hasta?.ToString("yyyy-MM-dd"))"
               asp-route-usuario="@Model.Usuario"
               aria-current="@(Model.Seccion == seccion.Key ? "page" : null)"
               class="btn @(Model.Seccion == seccion.Key ? "btn-primary" : "btn-outline-dark")">
                @seccion.Value
            </a>
        }
    </nav>

    <form id="formFiltrosAuditoria"
          asp-controller="Auditoria"
          asp-action="Index"
          method="get">

            <partial name="_FiltrosAuditoria" model="Model" />
        </form>

        <form id="formAnalisisAuditoria"
              asp-controller="Auditoria"
              asp-action="Analizar"
              method="post"
              asp-antiforgery="true">

            <input type="hidden" name="Seccion" value="@Model.Seccion" />
            <input type="hidden" name="Desde" value="@(Model.Desde?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="Hasta" value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="Entidad" value="@Model.Entidad" />
            <input type="hidden" name="Accion" value="@Model.Accion" />
            <input type="hidden" name="Usuario" value="@Model.Usuario" />
        </form>

        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
            <button type="submit"
                    form="formFiltrosAuditoria"
                    class="btn btn-primary">
                Aplicar filtros
            </button>

            <a asp-controller="Auditoria"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Limpiar
            </a>

            <button type="submit"
                    form="formAnalisisAuditoria"
                    class="btn btn-outline-primary">
                Analizar con IA
            </button>
        </div>

        <p class="small text-muted mb-0 mt-2">
            El análisis usa los filtros aplicados a la tabla.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorIA))
    {
        <div class="alert alert-warning mb-4" role="alert">
            @Model.ErrorIA
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ResultadoIA))
    {
        <section class="ee-filtros mb-4" aria-labelledby="tituloAnalisisIA">
            <h2 id="tituloAnalisisIA" class="h5">Análisis con IA</h2>

            <p class="small text-muted">
                Se analizaron @Model.Analizados de @Model.TotalParaAnalisis
                registros que coinciden con los filtros.
            </p>

            <div class="ee-resultado-ia">@Model.ResultadoIA</div>
        </section>
    }

    <div class="row g-3 mb-4">
        @foreach (var indicador in new[]
                {
                ("Operaciones", Model.Total),
                ("Altas", Model.Altas),
                ("Modificaciones", Model.Modificaciones),
                ("Eliminaciones", Model.Eliminaciones),
                ("Errores", Model.Errores)
                })
        {
            <div class="col-6 col-lg">
                <div class="ee-indicador">
                    <span>@indicador.Item1</span>
                    <strong>@indicador.Item2</strong>
                </div>
            </div>
        }
    </div>

    <p class="text-muted small">
        Horario de Argentina.
        Los indicadores corresponden a todos los resultados filtrados.
        Una operación de auditoría no equivale necesariamente a una venta.
    </p>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Fecha</th>
                    <th scope="col">Usuario</th>
                    <th scope="col">Acción</th>
                    <th scope="col">Entidad / página</th>
                    <th scope="col">Registro</th>
                    <th scope="col"><span class="visually-hidden">Detalle</span></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Registros.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No hay registros para estos filtros.
                        </td>
                    </tr>
                }

                @foreach (var registro in Model.Registros)
                {
                    var fecha = DateTime.SpecifyKind(
                    registro.Fecha, DateTimeKind.Utc).AddHours(-3);
                    var esError = registro.Accion == "Error";

                    <tr>
                        <td>
                            @fecha.ToString("dd/MM/yyyy")
                            <small class="d-block">@fecha.ToString("HH:mm:ss")</small>
                        </td>

                        <td>@registro.UsuarioNombre</td>

                        <td>
                            <span class="badge @(esError ? "bg-danger" : "bg-secondary")">
                                @registro.Accion
                            </span>
                        </td>

                        <td>
                            @(esError
                                                    ? AuditoriaConsultas.PaginaError(registro.ValoresNuevos)
                                                    : registro.Entidad)
                    </td>

                        <td class="ee-auditoria-id">@registro.RegistroId</td>

                        <td>
                            <a asp-controller="Auditoria"
                               asp-action="Details"
                               asp-route-id="@registro.Id"
                               class="btn btn-sm btn-outline-primary text-nowrap">
                                @(esError ? "Ver error" : "Ver cambios")
                            </a>
                        </td>
                    </tr>
                                }
            </tbody>
        </table>
    </div>

    <nav class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4"
         aria-label="Páginas de auditoría">

        <span>Página @Model.Pagina de @Model.TotalPaginas</span>

        <div class="d-flex gap-2">
            @if (Model.Pagina > 1)
            {
                <a asp-controller="Auditoria"
                   asp-action="Index"
                   asp-route-seccion="@Model.Seccion"
                   asp-route-desde="@(Model.Desde?.ToString("yyyy-MM-dd"))"
                   asp-route-hasta="@(Model.Hasta?.ToString("yyyy-MM-dd"))"
                   asp-route-entidad="@Model.Entidad"
                   asp-route-accion="@Model.Accion"
                   asp-route-usuario="@Model.Usuario"
                   asp-route-pagina="@(Model.Pagina - 1)"
                   class="btn btn-outline-dark">
                    Anterior
                </a>
            }

            @if (Model.Pagina < Model.TotalPaginas)
            {
                <a asp-controller="Auditoria"
                   asp-action="Index"
                   asp-route-seccion="@Model.Seccion"
                   asp-route-desde="@(Model.Desde?.ToString("yyyy-MM-dd"))"
                   asp-route-hasta="@(Model.Hasta?.ToString("yyyy-MM-dd"))"
                   asp-route-entidad="@Model.Entidad"
                   asp-route-accion="@Model.Accion"
                   asp-route-usuario="@Model.Usuario"
                   asp-route-pagina="@(Model.Pagina + 1)"
                   class="btn btn-outline-dark">
                    Siguiente
                </a>
            }
        </div>
    </nav>
</section>
@model EuforiaEssencePW.Models.Marca

@{
    ViewData["Title"] = "Eliminar marca";
}

<h1>Eliminar marca</h1>

<div class="card card-body my-3">
    <h2 class="h5">@Model.Nombre</h2>
    <p class="text-muted mb-0">
        Solo se puede eliminar una marca sin perfumes asociados.
    </p>
</div>

<form asp-controller="Marcas"
      asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post"
      data-confirmar
      data-titulo="¿Eliminar esta marca?"
      data-mensaje="Esta operación no se puede deshacer."
      data-boton="Eliminar marca">

    <input type="hidden" asp-for="Id" />

    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-danger">
            Eliminar marca
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Volver
        </a>
    </div>
</form>
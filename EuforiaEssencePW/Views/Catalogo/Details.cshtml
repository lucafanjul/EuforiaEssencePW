@model EuforiaEssencePW.Models.Perfume

@{
    ViewData["Title"] = Model.Nombre;
    var cultura = System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    var presentaciones = Model.Presentaciones
        .Where(p => p.Activo)
        .OrderBy(p => p.Mililitros)
        .ToList();

    var puedeComprar = User.IsInRole("Cliente") ||
        User.IsInRole("Administrador");
}

<section class="ee-detalle">
    <nav aria-label="Ubicación" class="ee-ruta">
        <a asp-action="Index">Catálogo</a>
        <span aria-hidden="true">/</span>
        <span>@Model.Nombre</span>
    </nav>

    <div class="row g-4 g-lg-5">
        <div class="col-lg-5">
            <div class="ee-detalle-imagen">
                @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
                {
                    <img src="@Url.Content(Model.ImagenUrl)"
                         alt="@Model.Nombre" />
                }
                else
                {
                    <span class="ee-sin-imagen">
                        Euphoria Essence
                        <small>Imagen no disponible</small>
                    </span>
                }
            </div>
        </div>

        <div class="col-lg-7">
            <p class="ee-marca">@Model.Marca?.Nombre</p>
            <h1>@Model.Nombre</h1>

            @if (Model.Categoria != null)
            {
                <span class="ee-detalle-categoria">
                    @Model.Categoria.Nombre
                </span>
            }

            <p class="ee-descripcion">@Model.Descripcion</p>

            @if (!string.IsNullOrWhiteSpace(Model.NotasOlfativas))
            {
                <div class="ee-notas">
                    <h2>Notas olfativas</h2>
                    <p>@Model.NotasOlfativas</p>
                </div>
            }

            <div class="ee-compra">
                <h2>Elegí tu presentación</h2>
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-controller="Presentaciones"
                       asp-action="Create"
                       class="btn btn-outline-dark mb-3">
                        Agregar presentación y stock
                    </a>
                }
                <p class="text-muted small">
                    Precios expresados en pesos argentinos.
                </p>

                @if (!presentaciones.Any())
                {
                    <div class="alert alert-info">
                        Este perfume todavía no tiene presentaciones disponibles.
                    </div>
                }
                else
                {
                    @foreach (var item in presentaciones)
                    {
                        <div class="ee-presentacion">
                            <div class="ee-presentacion-datos">
                                <strong class="ee-presentacion-tamano">
                                    @item.Mililitros ml
                                </strong>

                                <strong class="ee-presentacion-precio">
                                    @item.Precio.ToString("C2", cultura)
                                </strong>
                            </div>

                            @if (User.IsInRole("Administrador"))
                            {
                                <p class="small text-muted">
                                    Unidades en stock: <strong>@item.Stock</strong>

                                    <a asp-controller="Presentaciones"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="ms-2">
                                        Editar precio y stock
                                    </a>
                                </p>
                            }

                            @if (item.Stock <= 0)
                            {
                                <button type="button"
                                        class="btn ee-btn-sin-stock w-100"
                                        disabled>
                                    Sin stock
                                </button>
                            }
                            else if (puedeComprar)
                            {
                                <form asp-controller="Carrito"
                                      asp-action="Agregar"
                                      method="post"
                                      class="ee-presentacion-form">

                                    <input type="hidden"
                                           name="presentacionId"
                                           value="@item.Id" />

                                    <div class="ee-cantidad">
                                        <label for="cantidad-@item.Id">
                                            Cantidad
                                        </label>

                                        <input type="number"
                                               id="cantidad-@item.Id"
                                               name="cantidad"
                                               value="1"
                                               min="1"
                                               max="@Math.Min(item.Stock, 999)"
                                               class="form-control" />
                                    </div>

                                    <button type="submit" class="btn btn-primary">
                                        Agregar al carrito
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-area="Identity"
                                   asp-page="/Account/Login"
                                   asp-route-returnUrl="@Url.Action("Details", "Catalogo", new { id = Model.Id })"
                                   class="btn btn-outline-primary w-100">
                                    Iniciar sesión para comprar
                                </a>
                            }
                        </div>
                    }

                    <p class="ee-compra-aclaracion">
                        Agregar al carrito no reserva unidades.
                        El stock se verifica al confirmar el pedido.
                    </p>
                }
            </div>
        </div>
    </div>
</section>
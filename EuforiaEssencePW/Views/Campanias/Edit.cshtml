@model EuforiaEssencePW.Models.Campania

@{
    ViewData["Title"] = Model.Id == 0
        ? "Nueva campaña"
        : "Editar campaña";
}

<h1>@ViewData["Title"]</h1>

<div class="card card-body">
    <form asp-action="Edit"
          asp-route-id="@(Model.Id == 0 ? (int?)null : Model.Id)"
          method="post">

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label"></label>
            <input asp-for="Titulo" class="form-control"
                   placeholder="Por ejemplo: Perfumes para el verano" />
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion"
                      class="form-control"
                      rows="3"></textarea>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Desde" class="form-label"></label>
                <input asp-for="Desde" type="date" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Hasta" class="form-label"></label>
                <input asp-for="Hasta" type="date" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Prioridad" class="form-label"></label>
                <input asp-for="Prioridad"
                       type="number" min="0" max="999"
                       class="form-control" />
                <div class="form-text">
                    Un número mayor tiene preferencia en la portada.
                </div>
            </div>
        </div>

        <fieldset class="mb-4">
            <legend class="h5">Perfumes de la campaña</legend>

            @foreach (var perfume in
                        (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                        ViewBag.Perfumes)
            {
                <div class="form-check mb-2">
                    <input type="checkbox"
                           name="perfumesSeleccionados"
                           value="@perfume.Value"
                           id="perfume-@perfume.Value"
                           checked="@perfume.Selected"
                           class="form-check-input" />

                    <label for="perfume-@perfume.Value"
                           class="form-check-label">
                        @perfume.Text
                    </label>
                </div>
            }

            <p class="form-text">
                Solo los perfumes activos se muestran al público.
                Los que no tienen stock se muestran como agotados.
            </p>
        </fieldset>

        <div class="form-check mb-4">
            <input asp-for="Activa" class="form-check-input" />
            <label asp-for="Activa" class="form-check-label">
                Campaña activa
            </label>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">
                Guardar campaña
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Volver
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
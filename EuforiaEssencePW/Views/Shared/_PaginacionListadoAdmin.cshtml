@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var pagina = (int)(ViewData["Pagina"] ?? 1);
    var totalPaginas = (int)(ViewData["TotalPaginas"] ?? 1);
    var total = (int)(ViewData["TotalRegistros"] ?? 0);

    var filtros = new Dictionary<string, string>();

    foreach (var clave in new[] { "buscar", "marcaId", "categoriaId", "mililitros", "stock", "activo" })
    {
        if (Context.Request.Query.TryGetValue(clave, out var valor) &&
            !string.IsNullOrWhiteSpace(valor.ToString()))
        {
            filtros[clave] = valor.ToString();
        }
    }

    var anterior = new Dictionary<string, string>(filtros)
    {
        ["pagina"] = (pagina - 1).ToString()
    };

    var siguiente = new Dictionary<string, string>(filtros)
    {
        ["pagina"] = (pagina + 1).ToString()
    };
}

@if (total == 0)
{
    <p class="mt-3 mb-0">No se encontraron registros.</p>
}
else
{
    <nav class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4"
         aria-label="Páginas del listado">
        <span>@total registros · Página @pagina de @totalPaginas</span>

        <div class="d-flex gap-2">
            @if (pagina > 1)
            {
                <a asp-controller="@controlador" asp-action="Index"
                   asp-all-route-data="anterior"
                   class="btn btn-outline-secondary">Anterior</a>
            }

            @if (pagina < totalPaginas)
            {
                <a asp-controller="@controlador" asp-action="Index"
                   asp-all-route-data="siguiente"
                   class="btn btn-outline-secondary">Siguiente</a>
            }
        </div>
    </nav>
}
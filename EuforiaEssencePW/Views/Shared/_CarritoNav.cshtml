@using System.Text.Json

@{
    long cantidad = 0;

    var usuarioId = User.FindFirst(
        System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    if (!string.IsNullOrWhiteSpace(usuarioId))
    {
        var json = Context.Session.GetString("Carrito:" + usuarioId);

        if (!string.IsNullOrWhiteSpace(json))
        {
            try
            {
                var lineas =
                    JsonSerializer.Deserialize<Dictionary<int, int>>(json);

                cantidad = lineas?
                    .Where(l => l.Value > 0)
                    .Sum(l => (long)l.Value) ?? 0;
            }
            catch (JsonException)
            {
                cantidad = 0;
            }
        }
    }
}

<li class="nav-item">
    <a asp-area=""
       asp-controller="Carrito"
       asp-action="Index"
       id="enlaceCarrito"
       class="nav-link ee-nav-icono ee-carrito-nav"
       aria-label="Carrito, @cantidad unidades"
       title="Mi carrito">

        <svg width="25" height="25"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="1.7"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true">
            <path d="M2 3h3l3 12h11l3-9H6" />
            <circle cx="9" cy="20" r="1" />
            <circle cx="19" cy="20" r="1" />
        </svg>

        <span id="contadorCarrito"
              class="ee-carrito-contador"
              hidden="@(cantidad == 0)"
              aria-hidden="true">
            @cantidad
        </span>
    </a>
</li>
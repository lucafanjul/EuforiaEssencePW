@model EuforiaEssencePW.Models.Perfume

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion"
              class="form-control" rows="4"></textarea>
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="NotasOlfativas" class="form-label"></label>
    <textarea asp-for="NotasOlfativas"
              class="form-control" rows="2"></textarea>
    <span asp-validation-for="NotasOlfativas" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="MarcaId" class="form-label"></label>
        <select asp-for="MarcaId"
                class="form-select"
                asp-items="ViewBag.MarcaId">
            <option value="">Seleccione una marca</option>
        </select>
        <span asp-validation-for="MarcaId" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="CategoriaId" class="form-label"></label>
        <select asp-for="CategoriaId"
                class="form-select"
                asp-items="ViewBag.CategoriaId">
            <option value="">Seleccione una categoría</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>
</div>

<div class="form-check mb-3">
    <input asp-for="Activo" class="form-check-input" />
    <label asp-for="Activo" class="form-check-label"></label>
</div>
<div class="mb-3">
    <label for="imagen" class="form-label">
        Imagen del perfume
    </label>

    @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
    {
        <div class="mb-2">
            <img src="@Url.Content(Model.ImagenUrl)"
                 alt="@Model.Nombre"
                 class="img-thumbnail"
                 style="width: 140px; height: 160px; object-fit: contain;" />
        </div>
    }

    <input type="file"
           id="imagen"
           name="imagen"
           class="form-control"
           accept=".jpg,.jpeg,.png,.webp" />

    <span class="text-danger">
        @Html.ValidationMessage("imagen")
    </span>

    <div class="form-text">
        JPG, PNG o WEBP. Máximo 5 MB.
        Al editar, dejá este campo vacío para conservar la imagen.
    </div>
</div>
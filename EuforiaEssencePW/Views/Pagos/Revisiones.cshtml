@model IEnumerable<EuforiaEssencePW.Models.ViewModels.ComprobanteResumenViewModel>

@{
    ViewData["Title"] = "Revisión de pagos";
    var cultura = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    var filtro = (string)ViewBag.Estado;
    var pagina = (int)ViewBag.Pagina;
    var totalPaginas = (int)ViewBag.TotalPaginas;
    var pedidoId = (int?)ViewBag.PedidoId;
}

<h1>Revisión de pagos</h1>

@if (pedidoId.HasValue)
{
    <p class="text-muted">Comprobantes del pedido #@pedidoId.Value</p>
}

<p class="text-muted">
    Descargá el comprobante y verificá su correspondencia con el pedido
    antes de aprobarlo.
</p>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success" role="alert">@exito</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="d-flex flex-wrap gap-2 mb-4">
    @foreach (var estado in new[] { "Pendiente", "Aprobado", "Rechazado", "Todos" })
    {
        <a asp-action="Revisiones"
           asp-route-pedidoId="@pedidoId"
           asp-route-estado="@estado"
           class="btn @(filtro == estado ? "btn-primary" : "btn-outline-dark")">
            @estado
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="status">
        No hay comprobantes para este filtro.
    </div>
}

@foreach (var comprobante in Model)
{
    var fecha = DateTime.SpecifyKind(
        comprobante.FechaEnvio, DateTimeKind.Utc).AddHours(-3);

    <article class="card card-body mb-4">
        <div class="d-flex flex-wrap justify-content-between gap-3">
            <div>
                <h2 class="h5">Pedido #@comprobante.PedidoId</h2>
                <p class="mb-1">@comprobante.Cliente</p>
                <p class="text-muted mb-1">
                    @fecha.ToString("dd/MM/yyyy HH:mm") — Argentina
                </p>
            </div>

            <div>
                <strong>
                    @comprobante.ImporteEsperado.ToString("C2", cultura)
                </strong>
                <p class="mb-0">@comprobante.Estado</p>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 my-3">
            <a asp-action="Descargar"
               asp-route-id="@comprobante.Id"
               class="btn btn-outline-primary">
                Descargar comprobante
            </a>

            <a asp-controller="GestionPedidos"
               asp-action="Details"
               asp-route-id="@comprobante.PedidoId"
               class="btn btn-outline-secondary">
                Ver pedido
            </a>
        </div>

        @if (!string.IsNullOrWhiteSpace(comprobante.MotivoRechazo))
        {
            <p class="mt-2 mb-2">
                <strong>Motivo del rechazo:</strong>
                @comprobante.MotivoRechazo
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(comprobante.MotivoApelacion))
        {
            <p class="mt-2 mb-2">
                <strong>Explicación de la apelación:</strong>
                @comprobante.MotivoApelacion
            </p>
        }
        @if (!string.IsNullOrWhiteSpace(comprobante.MotivoApelacion))
        {
            <p class="mt-2 mb-2">
                <strong>Explicación de la apelación:</strong>
                @comprobante.MotivoApelacion
            </p>
        }
        @if (comprobante.PuedeRevisarse)
        {
            <form asp-controller="Pagos"
                  asp-action="Revisar"
                  method="post"
                  data-confirmar
                  data-titulo="¿Registrar la revisión?"
                  data-mensaje="Se actualizará el estado del pago del pedido."
                  data-boton="Confirmar revisión">

                <input type="hidden" name="id" value="@comprobante.Id" />
                <input type="hidden" name="pedidoId" value="@pedidoId" />

                <div class="mb-3">
                    <label for="motivo-@comprobante.Id" class="form-label">
                        Motivo, obligatorio si rechazás
                    </label>

                    <textarea id="motivo-@comprobante.Id"
                      name="motivo"
                      maxlength="500"
                      rows="2"
                      class="form-control"></textarea>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit"
                            name="decision"
                            value="Aprobado"
                            class="btn btn-success">
                        Aprobar pago
                    </button>

                    <button type="submit"
                            name="decision"
                            value="Rechazado"
                            class="btn btn-outline-danger">
                        Rechazar comprobante
                    </button>
                </div>
            </form>
        }
        else
        {
            <p class="text-muted mb-0">
                No admite revisión. Estado del pedido: @comprobante.EstadoPedido.
            </p>
        }
    </article>
}

<nav class="d-flex flex-wrap justify-content-between align-items-center gap-3"
     aria-label="Páginas de comprobantes">
    <span>Página @pagina de @totalPaginas</span>

    <div class="d-flex gap-2">
        @if (pagina > 1)
        {
            <a asp-action="Revisiones"
               asp-route-pedidoId="@pedidoId"
               asp-route-estado="@filtro"
               asp-route-pagina="@(pagina - 1)"
               class="btn btn-outline-dark">
                Anterior
            </a>
        }

        @if (pagina < totalPaginas)
        {
            <a asp-action="Revisiones"
               asp-route-pedidoId="@pedidoId"
               asp-route-estado="@filtro"
               asp-route-pagina="@(pagina + 1)"
               class="btn btn-outline-dark">
                Siguiente
            </a>
        }
    </div>
</nav>
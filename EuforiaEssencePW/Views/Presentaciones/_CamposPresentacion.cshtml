@model EuforiaEssencePW.Models.Presentacion

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="PerfumeId" class="form-label"></label>
    <select asp-for="PerfumeId"
            asp-items="ViewBag.PerfumeId"
            class="form-select">
        <option value="">Seleccione un perfume</option>
    </select>
    <span asp-validation-for="PerfumeId" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Mililitros" class="form-label"></label>
        <input asp-for="Mililitros"
               class="form-control"
               min="1" max="2000" />
        <span asp-validation-for="Mililitros" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Precio" class="form-label">
            Precio (ARS)
        </label>
        <input asp-for="Precio"
               type="number"
               step="0.01"
               min="0.01"
               max="99999999"
               class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Stock" class="form-label">
            Unidades disponibles
        </label>

        <input asp-for="Stock"
               type="number"
               min="0"
               step="1"
               class="form-control" />

        <span asp-validation-for="Stock"
              class="text-danger"></span>

        <div class="form-text">
            Cantidad de unidades de este tamaño.
            Con 0, se muestra “Sin stock”.
        </div>
    </div>
</div>

<div class="form-check mb-3">
    <input asp-for="Activo" class="form-check-input" />
    <label asp-for="Activo" class="form-check-label"></label>
</div>
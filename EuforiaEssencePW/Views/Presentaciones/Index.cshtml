@model IEnumerable<EuforiaEssencePW.Models.Presentacion>

@{
    ViewData["Title"] = "Presentaciones";
    var cultura = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h1 class="mb-1">Presentaciones</h1>
        <p class="text-muted mb-0">
            Tamaños, precios y stock de los perfumes.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Nueva presentación
    </a>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success" role="alert">@exito</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<partial name="_FiltrosListadoAdmin" />

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Perfume</th>
                    <th>Contenido</th>
                    <th>Precio (ARS)</th>
                    <th>Stock</th>
                    <th>Estado</th>
                    <th class="text-end pe-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
 
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3">
                            <strong>@item.Perfume?.Nombre</strong>
                        </td>
                        <td>@item.Mililitros ml</td>
                        <td>@item.Precio.ToString("C2", cultura)</td>
                        <td>
                            @if (item.Stock == 0)
                            {
                                <span class="badge bg-danger">Sin stock</span>
                            }
                            else
                            {
                                @item.Stock
                            }
                        </td>
                        <td>
                            <span class="badge @(item.Activo ? "bg-success" : "bg-secondary")">
                                @(item.Activo ? "Activa" : "Inactiva")
                            </span>
                        </td>
                        <td class="pe-3">
                            <div class="d-flex justify-content-end gap-2"
                                 style="min-width: 245px;">
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Editar
                                </a>
                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Detalles
                                </a>
                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_PaginacionListadoAdmin" />